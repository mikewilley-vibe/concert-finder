# Public browser configuration. These values are safe to expose only when
# Supabase Row Level Security is enabled and verified.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_ and never commit
# real values.
SUPABASE_SECRET_KEY=
TICKETMASTER_API_KEY=
CRON_SECRET=
