# Public Expo values only. These are bundled into the app.
# Never put TICKETMASTER_API_KEY, SUPABASE_SECRET_KEY, or CRON_SECRET here
# or anywhere in the Expo project.

# Concert Finder website that owns the Ticketmaster proxy routes.
EXPO_PUBLIC_API_BASE_URL=https://concert-finder-eta.vercel.app

# Supabase publishable URL and publishable/anon key. Safe only with RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
