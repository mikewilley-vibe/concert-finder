{
  "expo": {
    "name": "Local Shows",
    "slug": "local-shows",
    "scheme": "local-shows",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mikewilley.localshows",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Local Shows uses your current location to find nearby shows.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCalendarsWriteOnlyAccessUsageDescription": "Local Shows adds concerts you choose to your calendar.",
        "NSCalendarsFullAccessUsageDescription": "Local Shows adds concerts you choose to your calendar.",
        "NSCalendarsUsageDescription": "Local Shows adds concerts you choose to your calendar."
      }
    },
    "android": {
      "package": "com.mikewilley.localshows",
      "adaptiveIcon": {
        "backgroundColor": "#0c0b09",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0c0b09"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Local Shows uses your current location to find nearby shows."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Local Shows adds concerts you choose to your calendar."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "3ab09f9e-8ef9-4622-a2a3-87ab3ddfa8f7"
      }
    }
  }
}
